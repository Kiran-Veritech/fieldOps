# FieldOps Nexus — backend environment
# Shared MongoDB Atlas cluster for the team demo. Demo data lives in the
# `field-ops-ai` database (Atlas role is scoped to this DB) — run seed.py
# only if you need a reset.
MONGODB_URI=mongodb+srv://fieldOpsAdmin:zJDp6qUHcPenX9OE@onboarly-local.fht1qxt.mongodb.net/?retryWrites=true&w=majority&appName=ClusterFieldOps
MONGODB_DB=field-ops-ai
# Comma-separated list of origins allowed to call the API (the admin dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated approved work-email domains for registration
APPROVED_EMAIL_DOMAINS=fieldops.io
