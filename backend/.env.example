# FieldOps Nexus — backend environment (production active)
# Public API: https://fieldops-nexus.onrender.com

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=field-ops-ai

# Production CORS (add your hosted admin origin)
CORS_ORIGINS=https://fieldops-nexus.onrender.com,http://localhost:5173,http://localhost:4173
# Development-only CORS example:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_SECRET=replace-with-a-long-random-secret
# Development:
# JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

APPROVED_EMAIL_DOMAINS=veritech.ai

RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=FieldOps Nexus <onboarding@resend.dev>
OTP_EXPIRE_MINUTES=10

# Render:
# PYTHON_VERSION=3.12.8
